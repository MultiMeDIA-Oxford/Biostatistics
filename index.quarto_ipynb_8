        "#| echo: false\n",
        "#| fig-cap: \"Summary of the processed Cleveland Heart Disease dataset used throughout the module.\"\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "OXFORD_BLUE = \"#002147\"\n",
        "CLINICAL_RED = \"#C73E3A\"\n",
        "ACCENT_BLUE = \"#3A7CA5\"\n",
        "\n",
        "url = \"https://archive.ics.uci.edu/ml/machine-learning-databases/heart-disease/processed.cleveland.data\"\n",
        "\n",
        "columns = [\n",
        "    \"age\", \"sex\", \"cp\", \"trestbps\", \"chol\", \"fbs\", \"restecg\",\n",
        "    \"thalach\", \"exang\", \"oldpeak\", \"slope\", \"ca\", \"thal\", \"num\"\n",
        "]\n",
        "\n",
        "df = pd.read_csv(url, header=None, names=columns, na_values=\"?\")\n",
        "df[\"heart_disease\"] = np.where(df[\"num\"] == 0, \"No heart disease\", \"Heart disease\")\n",
        "\n",
        "n_patients = df.shape[0]\n",
        "n_features = 13\n",
        "n_disease = int((df[\"num\"] > 0).sum())\n",
        "n_no_disease = int((df[\"num\"] == 0).sum())\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "ax.axis(\"off\")\n",
        "\n",
        "metrics = [\n",
        "    (\"Patients\", n_patients, OXFORD_BLUE),\n",
        "    (\"Clinical variables\", n_features, ACCENT_BLUE),\n",
        "    (\"Heart disease\", n_disease, CLINICAL_RED),\n",
        "    (\"No heart disease\", n_no_disease, ACCENT_BLUE),\n",
        "]\n",
        "\n",
        "x_positions = [0.13, 0.38, 0.63, 0.88]\n",
        "\n",
        "for (label, value, colour), x in zip(metrics, x_positions):\n",
        "    ax.text(\n",
        "        x, 0.62, str(value),\n",
        "        ha=\"center\", va=\"center\",\n",
        "        fontsize=26, fontweight=\"bold\",\n",
        "        color=colour\n",
        "    )\n",
        "    ax.text(\n",
        "        x, 0.43, label,\n",
        "        ha=\"center\", va=\"center\",\n",
        "        fontsize=12,\n",
        "        bbox=dict(boxstyle=\"round,pad=0.45\", fc=\"white\", ec=colour, lw=1.6)\n",
        "    )\n",
        "\n",
        "ax.text(\n",
        "    0.5, 0.9,\n",
        "    \"Processed Cleveland Heart Disease Dataset\",\n",
        "    ha=\"center\", va=\"center\",\n",
        "    fontsize=16, fontweight=\"bold\", color=OXFORD_BLUE\n",
        ")\n",
        "\n",
        "plt.show()"
      ],
