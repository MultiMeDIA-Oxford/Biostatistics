        "\n",
        "    let x = Math.random()*6 - 3;\n",
        "\n",
        "    let noise = (Math.random()*2 - 1);\n",
        "\n",
        "    let y = r*x + Math.sqrt(1-r*r)*noise*2;\n",
        "\n",
        "    points.push({x:x,y:y});\n",
        "  }\n",
        "\n",
        "  return points;\n",
        "}\n",
        "\n",
        "function drawCorrelation(){\n",
        "\n",
        "  const r = parseFloat(document.getElementById(\"corrSlider\").value);\n",
        "\n",
