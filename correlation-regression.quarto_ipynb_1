        "    ctx.beginPath();\n",
        "    ctx.arc(x,y,4,0,2*Math.PI);\n",
        "    ctx.fillStyle = \"#2C7FB8\";\n",
        "    ctx.fill();\n",
        "\n",
        "  });\n",
        "\n",
        "  ctx.strokeStyle = \"#333\";\n",
        "\n",
        "  ctx.beginPath();\n",
        "  ctx.moveTo(50,210);\n",
        "  ctx.lineTo(650,210);\n",
        "  ctx.stroke();\n",
        "\n",
        "  ctx.beginPath();\n",
        "  ctx.moveTo(350,30);\n",
