        "\n",
        "    // Y-axis ticks\n",
        "    const yTicks = [80, 100, 120, 140, 160, 180, 200];\n",
        "\n",
        "    yTicks.forEach(function(tick){\n",
        "        const py = yScale(tick);\n",
        "\n",
        "        ctx.beginPath();\n",
        "        ctx.moveTo(left - 6, py);\n",
        "        ctx.lineTo(left, py);\n",
        "        ctx.stroke();\n",
        "\n",
